# App bind address used by startup commands
APP_HOST=0.0.0.0
APP_PORT=5000
APP_ENV=development

# Comma-separated list, example:
# CORS_ORIGINS=http://localhost:5500,http://172.16.45.22:5500
CORS_ORIGINS=https://localhost,https://172.16.45.22

# Optional absolute path override for static frontend files.
# By default this is ../frontend from the backend folder.
# FRONTEND_DIR=D:\STEM Project\frontend

# Admin authentication settings
ADMIN_USERNAME=admin
# For local development only; leave unset in non-dev when using ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-secret
JWT_EXPIRE_MINUTES=60
# Optional hashed password (recommended in non-dev):
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$260000$<salt>$<hash_b64>

# Upload validation
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
IMAGE_CLASSIFIER_PROVIDER=heuristic

# Per-IP rate limits
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_IMAGES_PER_MINUTE=20
RATE_LIMIT_JOBS_PER_MINUTE=30
